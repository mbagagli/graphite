# Public repository: admit only maintained source, tests, tooling and docs.
/*
!/.gitignore
!/.github/
!/.cargo/
!/.node-version
!/.npmrc
!/.pre-commit-config.yaml
!/.prettierignore
!/.prettierrc.json
!/README.md
!/LICENSE
!/PRIVACY.md
!/CODE_SIGNING_POLICY.md
!/package.json
!/package-lock.json
!/rust-toolchain.toml
!/eslint.config.js
!/tsconfig*.json
!/vite.config.ts
!/index.html
!/src/
!/src-tauri/
!/scripts/
!/public/
!/demo/
!/website/
!/docs/
!/tools/
!/evaluation/
!/graphics_theme/

# Local instructions and planning state never belong in public source.
AGENTS.md
GOAL.md
ROADMAP.md
HANDOFF.md
DESIGN.md
ARCHITECTURE.md
PRODUCT.md
.agents/
.codex/
.impeccable/
__pycache__/
*.pyc
.venv/
venv/

# Public documentation only; local plans and release receipts stay local.
/docs/*
!/docs/development.md
!/docs/graph-navigation.md
!/docs/help-and-analytics.md
!/docs/lenses.md
!/docs/library-preparation.md
!/docs/linux-cuda-package.md
!/docs/pdf-editing.md
!/docs/releasing.md
!/docs/release/
/docs/release/*
!/docs/release/BUILD.md
!/docs/release/DEMO.md
!/docs/release/SECURITY.md
!/docs/release/WINDOWS.md
!/docs/release/ZENODO.md

# Deterministic evaluation inputs, without private runs or historical reports.
/evaluation/*
!/evaluation/upstream-rag-v1/
/evaluation/upstream-rag-v1/*
!/evaluation/upstream-rag-v1/checksums.json
!/evaluation/upstream-rag-v1/corpus.json
!/evaluation/upstream-rag-v1/queries.json
!/evaluation/upstream-rag-v1/review-key.json
!/evaluation/upstream-rag-v1/protocol.json
!/evaluation/pdf-search-v1/
/evaluation/pdf-search-v1/*
!/evaluation/pdf-search-v1/*-v1.json
/tools/rag-comparison/README.md

# JavaScript dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# Frontend build output and tool caches
/.cache/
/artifacts/
dist/
dist-ssr/
.vite/
.vite-inspect/
*.tsbuildinfo
vite.config.*.timestamp-*
.eslintcache
.stylelintcache
.prettier-cache

# Rust and Tauri build output
target/
src-tauri/gen/schemas/
**/*.rs.bk
*.pdb

# Test, coverage, and profiling output
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
junit*.xml
*.profraw

# Logs and crash reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.dmp

# Environment files and local secrets
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
*.p12
*.pfx

# Local application data and private research material
/.graphy/
/.graphy-data/
/app-data/
/runtime-data/
/research-library/
/attachments/
/pdf-cache/
/indexes/
/embeddings/
/models/
/exports/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.faiss
*.hnsw
*.gguf

# Local PDF benchmark inputs, raw outputs, models, and candidate binaries
/tools/pdf-benchmark/corpus/local/*
!/tools/pdf-benchmark/corpus/local/.gitignore
/tools/pdf-benchmark/results/*
!/tools/pdf-benchmark/results/.gitignore
/tools/pdf-benchmark/assets/
/tools/pdf-benchmark/**/target/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Editor settings
.idea/
.fleet/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# Operating-system metadata
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Generated landing-page preview
/dist-site/
