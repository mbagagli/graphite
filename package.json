{
  "name": "graphite",
  "private": true,
  "version": "0.3.4",
  "description": "Discover Knowledge with a local-first visual research environment",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:dev:cuda": "node scripts/desktop-dev.mjs --cuda",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "check:hygiene": "node scripts/repository-hygiene.mjs",
    "check:privacy": "node scripts/privacy-check.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "package:check": "node scripts/package-config-check.mjs",
    "package:installed-smoke": "node scripts/installed-package-smoke.mjs",
    "package:release-candidate": "node scripts/release-candidate.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qa:performance": "node scripts/performance-qa.mjs",
    "qa:performance:large": "node scripts/performance-qa.mjs large --large",
    "qa:visual": "node scripts/visual-qa.mjs",
    "test": "npm run test:unit && npm run test:comparison",
    "tauri": "tauri",
    "test:unit": "vitest run src scripts --exclude scripts/build-site.test.mjs",
    "test:site": "vitest run scripts/build-site.test.mjs",
    "test:comparison": "node --test tools/rag-comparison/check.test.mjs",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "site:build": "node scripts/build-site.mjs",
    "package:build": "node scripts/build-release.mjs",
    "demo:prepare": "node scripts/real-demo.mjs",
    "demo:check": "node scripts/real-demo.mjs",
    "qa:lenses": "node scripts/lenses-smoke.mjs",
    "qa:graph-picking": "node scripts/graph-picking-smoke.mjs",
    "qa:pages": "node scripts/pages-smoke.mjs",
    "qa:release-ui": "node scripts/release-ui-smoke.mjs",
    "demo:import": "node scripts/import-real-demo.mjs",
    "qa:agent-controls": "node scripts/agent-controls-smoke.mjs",
    "demo:archive": "node scripts/demo-archive.mjs",
    "qa:pdf-editor": "node scripts/pdf-editor-smoke.mjs",
    "cuda:prepare": "node scripts/prepare-cuda.mjs --download"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "3d-force-graph": "^1.80.2",
    "d3-force-3d": "3.0.6",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
